{
  "name": "cyberdeck-workspace",
  "version": "1.3.0",
  "private": true,
  "license": "Unlicense",
  "description": "Cyberdeck (visual novel engine) and Datajack (player)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "checks": "node checks/run.mjs",
    "checks:desktop": "node checks/run.mjs --desktop",
    "guide:images": "node checks/run.mjs guide-images && node checks/copy-guide-images.mjs",
    "release": "node scripts/packageRelease.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
